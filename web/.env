# 后端 FastAPI 地址（Vite dev 服务器会把 /kanna_dependency 代理到这里）
# 前后端在同一台机器：保持 http://localhost:12138 即可
# 机器人后端部署在另一台机器时：改为 http://<该机器的内网IP>:12138
VITE_API_URL=http://localhost:12138
VITE_API_BASE=/kanna_dependency

# 允许用域名访问前端。Vite 5.4.12 起加了 host 检查（防 DNS rebinding），
# 默认只放行 localhost / IP，用域名访问会被 403，必须在这里显式列出。
# 多个域名用英文逗号分隔，例如：VITE_ALLOWED_HOSTS=example.com,foo.example.com
# 只用 IP 或 localhost 访问时留空即可。
VITE_ALLOWED_HOSTS=
